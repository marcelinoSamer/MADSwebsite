# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# Only the two VITE_ values are needed to run the apps. The rest are for
# provisioning and deployment, and belong on a maintainer's laptop or in CI —
# never in a browser bundle.

# --- Needed to run the apps ---------------------------------------------
# Safe to expose: the anon key grants nothing on its own, every table is
# gated by row-level security. Leave both blank to run on the in-memory mock.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Admin only: provisioning and deployment ----------------------------
# service_role bypasses RLS entirely. Never put it in a VITE_ variable and
# never commit it.
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Personal access tokens for the Supabase Management API and Vercel CLI.
SUPABASE_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Seeded admin accounts ----------------------------------------------
# Read by scripts/seed-supabase.mjs to create or repair the Supabase Auth
# users. Changing a password here and re-running the script rotates it.
MADS_EMAIL=mads@aucegypt.edu
MADS_PASSWORD=
ADMIN_EMAIL=Admin@mads.auc
ADMIN_PASSWORD=
